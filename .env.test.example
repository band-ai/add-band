# Local credentials for the pa-conformance live suite — copy to .env.test
# (git-ignored; pa-conformance auto-loads it) and fill in the keys.

# The Band owner/driver key: provisions every agent and room in a run.
BAND_API_KEY_USER=
# The Band environment (defaults to app.band.ai when unset).
BAND_BASE_URL=https://platform.dev.band.ai
BAND_WS_URL=wss://platform.dev.band.ai/api/v1/socket/websocket
# Passed through to the harnesses' model calls.
ANTHROPIC_API_KEY=

# Failure deadline per waited turn. NanoClaw's first-contact turns carry a
# greeting before the actual reply and don't fit the toolkit's 60s default;
# 120 matches the CI workflow and band-sdk-python's e2e turn budget.
E2E_TIMEOUT=120

# --- Optional suite knobs (see pa-conformance/README.md) ---
# The suite is live-only; this is its hard gate.
#E2E_TESTS_ENABLED=true
# Hosted test class. `integration` uses supplied model decisions only;
# `e2e` permits provider passthrough (the default).
#PA_TEST_LANE=e2e
#PA_MODEL_MODE=passthrough
# Subset of harnesses, e.g. hermes,openclaw (default: all three).
#PA_HARNESSES=
# Prepared NanoClaw checkout — absolute path, created once by
# `NANOCLAW_SRC=... bash pa-conformance/stacks/nanoclaw/prepare.sh`.
#NANOCLAW_SRC=
# hermes-band-platform ref to bake into the Hermes image.
#BAND_HERMES_REF=
# Released `hermes-band` PyPI specifier to bake in instead (e.g. ==1.2.3);
# falls back to the ref above.
#BAND_HERMES_VERSION=
