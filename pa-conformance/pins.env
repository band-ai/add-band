# Pinned upstream components — the single source of truth read by the stacks,
# harnesses, prepare script, and CI (renovate.json keeps these fresh via PRs).
# The same-named env var (or .env.test) overrides a pin for local hacking; CI
# dispatch inputs override via the workflow's resolve-pins step.
#
# These repos publish no release tags, so an immutable commit SHA is the only
# reproducible pin for them.

# renovate: datasource=git-refs depName=https://github.com/band-ai/hermes-band-platform currentValue=main
BAND_HERMES_REF=150ee430cc90386b9f3e41447c0177080a636255

# Released PyPI distribution of the same plugin, preferred over the ref above
# when set. A PEP 440 specifier carrying its own operator — `==1.2.3` pins one
# release; quote the value if it contains `<` or `>`, which are shell redirects
# to the `source` in CI. Empty because band-ai/hermes-band-platform#20 has not
# published it yet; note the distribution is `hermes-band`, as the old name on
# PyPI belongs to an unrelated third party (INT-1137). Set this once by hand to
# switch the Hermes image over to PyPI — Renovate advances it from there.
# renovate: datasource=pypi depName=hermes-band
BAND_HERMES_VERSION=

# renovate: datasource=docker depName=nousresearch/hermes-agent
HERMES_IMAGE_TAG=v2026.7.7.2

# renovate: datasource=git-refs depName=https://github.com/band-ai/nanoclaw-band currentValue=main
NANOCLAW_REF=181f06631d35cf4aacec3ed2b3acb9beaba083e8

# renovate: datasource=git-refs depName=https://github.com/band-ai/nanoclaw-band currentValue=band/adapter
NANOCLAW_PAYLOAD_REF=a7bf188caea75f8eb29cd4283f1f765b13cb497c

# renovate: datasource=npm depName=@band-ai/sdk
NANOCLAW_BAND_SDK_VERSION=0.1.6

# renovate: datasource=npm depName=@band-ai/rest-client
NANOCLAW_BAND_REST_CLIENT_VERSION=0.0.121

# renovate: datasource=npm depName=@band-ai/openclaw-channel-band
OPENCLAW_CHANNEL_VERSION=0.1.9
